<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:type="linear" android:angle="135"
                android:startColor="#005566" android:endColor="#003355" />
            <stroke android:width="1.5dp" android:color="#00F0FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:type="linear" android:angle="135"
                android:startColor="#0A2238" android:endColor="#081A2E" />
            <stroke android:width="1dp" android:color="#00AACC" />
        </shape>
    </item>
</selector>
