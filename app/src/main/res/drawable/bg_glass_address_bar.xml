<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0800F0FF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <!-- Glass surface -->
    <item android:top="1dp" android:bottom="1dp" android:start="1dp" android:end="1dp">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="90"
                android:startColor="#141E34" android:endColor="#101828" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#28FFFFFF" />
        </shape>
    </item>
</layer-list>
