<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="20dp"
                android:startColor="#1A4A5A" android:endColor="#102838" />
            <stroke android:width="1dp" android:color="#00F0FF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="20dp"
                android:startColor="#0F2A38" android:endColor="#0A1820" />
            <stroke android:width="1dp" android:color="#00F0FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#00FFFFFF" />
        </shape>
    </item>
</selector>
