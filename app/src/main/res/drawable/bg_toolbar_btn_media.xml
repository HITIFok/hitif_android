<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="20dp"
                android:startColor="#1A5A6A" android:endColor="#103848" />
            <stroke android:width="1.5dp" android:color="#00F0FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="20dp"
                android:startColor="#0D2838" android:endColor="#0A1828" />
            <stroke android:width="1dp" android:color="#1A4A5A" />
        </shape>
    </item>
</selector>
