<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:type="linear" android:angle="135"
                android:startColor="#1A3850" android:endColor="#142838" />
            <stroke android:width="1dp" android:color="#35FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:type="linear" android:angle="135"
                android:startColor="#121E32" android:endColor="#0E1826" />
            <stroke android:width="1dp" android:color="#22FFFFFF" />
        </shape>
    </item>
</selector>
