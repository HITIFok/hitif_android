<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:type="linear" android:angle="135"
                android:startColor="#1A3850" android:endColor="#162838" />
            <stroke android:width="1.5dp" android:color="#2A7090" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:type="linear" android:angle="135"
                android:startColor="#101A2E" android:centerColor="#141E34" android:endColor="#121830" />
            <stroke android:width="1dp" android:color="#22FFFFFF" />
        </shape>
    </item>
</selector>
