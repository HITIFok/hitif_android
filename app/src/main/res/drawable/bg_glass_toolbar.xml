<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="0"
                android:startColor="#0800F0FF" android:centerColor="#06FF44FF" android:endColor="#0800F0FF" />
        </shape>
    </item>
    <!-- Glass toolbar -->
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="0"
                android:startColor="#0C1628" android:centerColor="#101830" android:endColor="#0C1628" />
            <stroke android:width="1dp" android:color="#22FFFFFF" />
        </shape>
    </item>
</layer-list>
