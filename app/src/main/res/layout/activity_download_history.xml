<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient_main">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical"
        android:background="@drawable/bg_glass_toolbar"
        android:elevation="6dp">

        <ImageButton
            android:id="@+id/btnBackHistory"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_toolbar_btn"
            android:src="@drawable/ic_arrow_left"
            android:padding="10dp"
            android:contentDescription="Retour" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="TELECHARGEMENTS"
            android:textColor="@color/accent_cyan"
            android:fontFamily="@font/orbitron"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <ImageButton
            android:id="@+id/btnClearHistory"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_toolbar_btn"
            android:src="@drawable/ic_trash"
            android:padding="10dp"
            android:contentDescription="Supprimer tout" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/bg_divider_cyan" />
    <LinearLayout
        android:id="@+id/statsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="@drawable/bg_glass_panel_header">

        <!-- Row 1: File count + total downloaded size -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDownloadCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 fichier(s)"
                android:textColor="@color/text_dim"
                android:fontFamily="@font/rajdhani_medium"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvTotalSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 MB"
                android:textColor="@color/text_dim"
                android:fontFamily="@font/rajdhani_medium"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Row 2: Storage info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <!-- Storage icon (small dot) -->
            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@color/status_success"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvStorageInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stockage: calcul..."
                android:textColor="@color/text_dim"
                android:fontFamily="@font/rajdhani_medium"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Storage bar -->
        <ProgressBar
            android:id="@+id/storageBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="6dp"
            android:progressTint="@color/status_success"
            android:progressBackgroundTint="@color/bg_primary"
            android:max="100"
            android:progress="70" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/bg_divider_cyan" />

    <!-- Download list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerDownloads"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="16dp" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/emptyHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_download"
            android:alpha="0.3"
            android:contentDescription="Aucun telechargement" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Aucun telechargement"
            android:textColor="@color/text_dim"
            android:fontFamily="@font/rajdhani_medium"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Les fichiers telecharges apparaitront ici"
            android:textColor="@color/text_dim"
            android:textSize="11sp"
            android:alpha="0.6" />
    </LinearLayout>

</LinearLayout>
