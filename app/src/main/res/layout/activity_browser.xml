<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- ── Address bar ─────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/addressBarContainer"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_address_bar"
        android:paddingStart="12dp"
        android:paddingEnd="6dp"
        android:gravity="center_vertical"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/addressBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Rechercher ou saisir une URL…"
            android:hintTextColor="@color/text_dim"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:fontFamily="@font/rajdhani_medium"
            android:singleLine="true"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:selectAllOnFocus="true" />

        <ImageButton
            android:id="@+id/btnGo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_btn"
            android:src="@drawable/ic_arrow_right"
            android:padding="8dp"
            android:contentDescription="Naviguer" />
    </LinearLayout>

    <!-- ── Progress bar ────────────────────────────────────────────── -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:progressTint="@color/accent_cyan"
        android:progressBackgroundTint="@color/bg_surface"
        android:max="100"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/addressBarContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── WebView ──────────────────────────────────────────────────── -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintBottom_toTopOf="@id/bottomToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Bottom toolbar ───────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/bottomToolbar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_toolbar"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:gravity="center_vertical"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_toolbar_btn"
            android:src="@drawable/ic_arrow_left"
            android:padding="10dp"
            android:alpha="0.35"
            android:contentDescription="Précédent" />

        <!-- Forward -->
        <ImageButton
            android:id="@+id/btnForward"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_toolbar_btn"
            android:src="@drawable/ic_arrow_right"
            android:padding="10dp"
            android:alpha="0.35"
            android:contentDescription="Suivant" />

        <!-- Refresh / Stop -->
        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_toolbar_btn"
            android:src="@drawable/ic_refresh"
            android:padding="10dp"
            android:contentDescription="Actualiser" />

        <!-- Home -->
        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_toolbar_btn"
            android:src="@drawable/ic_home"
            android:padding="10dp"
            android:contentDescription="Accueil" />

        <!-- Media panel — highlighted -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/btnMedia"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_toolbar_btn_media"
                android:src="@drawable/ic_download"
                android:padding="10dp"
                android:contentDescription="Médias détectés" />

            <TextView
                android:id="@+id/btnMediaBadge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_badge"
                android:textColor="@color/bg_primary"
                android:textSize="9sp"
                android:gravity="center"
                android:fontFamily="@font/orbitron"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
