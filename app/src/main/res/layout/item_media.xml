<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="6dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_cyan"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Type badge -->
        <LinearLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_type_badge">

            <TextView
                android:id="@+id/tvExt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MP4"
                android:textColor="@color/accent_cyan"
                android:textSize="10sp"
                android:fontFamily="@font/orbitron"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvQuality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="H"
                android:textColor="@color/text_dim"
                android:textSize="9sp"
                android:fontFamily="@font/rajdhani_medium" />
        </LinearLayout>

        <!-- Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tvFilename"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="video_filename.mp4"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:fontFamily="@font/rajdhani_medium"
                android:maxLines="2"
                android:ellipsize="middle" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="— MB"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp"
                    android:fontFamily="@font/rajdhani_medium" />

                <TextView
                    android:id="@+id/tvDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/text_dim"
                    android:textSize="11sp"
                    android:fontFamily="@font/rajdhani_medium" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_btn"
                android:src="@drawable/ic_share"
                android:padding="7dp"
                android:contentDescription="Partager" />

            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_icon_btn"
                android:src="@drawable/ic_trash"
                android:padding="7dp"
                android:contentDescription="Supprimer" />

            <ImageButton
                android:id="@+id/btnDownload"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_icon_btn_cyan"
                android:src="@drawable/ic_download"
                android:padding="8dp"
                android:contentDescription="Télécharger" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
