<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ── Main app theme ───────────────────────────────────────────── -->
    <style name="Theme.HITIFBrowser" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorPrimaryVariant">@color/accent_cyan_dim</item>
        <item name="colorOnPrimary">@color/bg_primary</item>
        <item name="colorSecondary">@color/accent_magenta</item>
        <item name="colorOnSecondary">@color/bg_primary</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorError">@color/status_error</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_toolbar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:fontFamily">@font/rajdhani_medium</item>
    </style>

    <!-- ── Bottom sheet theme ───────────────────────────────────────── -->
    <style name="Theme.BottomSheet.Holo"
           parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="colorSurface">@color/bg_surface</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="bottomSheetStyle">@style/Widget.BottomSheet.Holo</item>
    </style>

    <style name="Widget.BottomSheet.Holo"
           parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="shapeAppearance">@style/ShapeAppearance.BottomSheet.Holo</item>
    </style>

    <style name="ShapeAppearance.BottomSheet.Holo"
           parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ── ImageButton style ────────────────────────────────────────── -->
    <style name="Widget.Toolbar.IconButton" parent="">
        <item name="android:background">@drawable/bg_toolbar_btn</item>
        <item name="android:tint">@color/text_dim</item>
        <item name="android:padding">10dp</item>
    </style>

</resources>
